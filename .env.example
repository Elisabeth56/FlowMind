# Copy to .env.local and fill in. Same names in local, preview and production.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the app runs, no trailing slash (http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=

# AI. Groq is the primary provider (console.groq.com/keys). The Gemini key is optional:
# with it, calls fall back to Gemini when Groq is rate-limited or down (aistudio.google.com/apikey).
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Paystack (Settings → API keys & webhooks). Plan codes are optional until the plans exist.
PAYSTACK_SECRET_KEY=
PAYSTACK_PRO_MONTHLY_PLAN_CODE=
PAYSTACK_PRO_YEARLY_PLAN_CODE=
