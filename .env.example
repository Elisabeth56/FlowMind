# Copy to .env.local and fill in. Same names in local, preview and production.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the app runs, no trailing slash (http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=

# AI. Groq runs everything (console.groq.com/keys). The Gemini key is optional and off by
# default: set it to add a second provider for when Groq is down (aistudio.google.com/apikey).
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Paystack (Settings → API keys & webhooks). Plan codes are optional until the plans exist.
PAYSTACK_SECRET_KEY=
PAYSTACK_PRO_MONTHLY_PLAN_CODE=
PAYSTACK_PRO_YEARLY_PLAN_CODE=

# Nightly demo cleanup. Any long random string; Vercel sends it to /api/cron/demo-cleanup.
CRON_SECRET=
